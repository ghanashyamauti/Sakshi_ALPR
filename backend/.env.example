# ==============================================================================
# Sakshi ALPR India - Backend Configuration Template
# ==============================================================================

# Database: Neon PostgreSQL or SQLite fallback (sqlite:///./data/alpr.db)
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# Server Config
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["*"]

# Model paths
PLATE_MODEL_PATH=models/license_plate_detector.pt
EASYOCR_MODEL_DIR=models/easyocr
CONFIDENCE_THRESHOLD=0.30
OCR_CONFIDENCE_THRESHOLD=0.35

# Storage settings
STORAGE_DIR=data
SAVE_DETECTIONS=True
APP_NAME=Sakshi ALPR India API
VERSION=2.0.0
